# connector_settings.py

# This file contains sensitive information and configuration for the LLM connector.
# It is recommended to load these values from environment variables or a secure vault in production.

import os

# --- API Keys ---
# Load from environment variables for security.
# To set them, run 'export OPENROUTER_API_KEY="your_key"' and 'export GROQ_API_KEY="your_key"' in your terminal.
OPENROUTER_API_KEY = os.environ.get(
    "OPENROUTER_API_KEY",
    "YOUR-API-KEY",
)
GROQ_API_KEY = os.environ.get("GROQ_API_KEY", "YOUR-API-KEY")

# --- Service Base URLs ---
LOCAL_LLAMA_BASE_URL = os.environ.get("LOCAL_LLAMA_BASE_URL", "YOUR-LOCAL_SERVER_URL")
# Note: This should be the base for the OpenAI-compatible v1 endpoint
OLLAMA_BASE_URL = os.environ.get("OLLAMA_BASE_URL", "YOUR-OLLAMA_SERVER_URL")
OPENROUTER_BASE_URL = os.environ.get(
    "OPENROUTER_BASE_URL", "https://openrouter.ai/api/v1"
)


# --- OpenRouter Specific Settings ---
OPENROUTER_REFERER = os.environ.get("OPENROUTER_REFERER", f"https://referrer-url")
OPENROUTER_SITE_NAME = os.environ.get("OPENROUTER_SITE_NAME", "YOUR-SITE-NAME")


# --- Model Pricing ---
# Prices are per 1 Million tokens (Input, Output)
# Add pricing to the model you need to use
MODEL_PRICING = {
    # OpenRouter Models
    ("openrouter", "google/gemini-2.5-flash"): (0.3, 2.50),
    ("openrouter", "meta-llama/llama-4-maverick"): (0.15, 0.60),
    # Ollama Models (Assume free, no API key needed by default)
    ("ollama", "llama3.1:8b"): (0.0, 0.0),
    # Local Model Example (Free)
    ("local", "local-model"): (0.0, 0.0),
}


# --- Default Provider and Model ---
DEFAULT_PROVIDER = "openrouter"
DEFAULT_MODEL = "google/gemini-2.5-flash"
